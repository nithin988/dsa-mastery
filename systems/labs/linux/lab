#!/bin/bash
# Usage: lab <name>   sets up a Systems Mastery lab, then opens a shell in it.
name="$1"
if [ -z "$name" ] || [ ! -f "/labs/$name.sh" ]; then
  echo "Available labs:"; ls /labs | grep -v solution | sed 's/\.sh$//' | sed 's/^/  /'; exit 1
fi
bash "/labs/$name.sh" || exit 1
[ -d "$HOME/sys-lab" ] && cd "$HOME/sys-lab" || cd "$HOME"
exec bash
